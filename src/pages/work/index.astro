---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { work, byPillar, pillars } from "../../data/work";
import { getEssays, readTime } from "../../lib/writing";

const flagships = byPillar(work.filter((w) => w.flagship && !w.draft));
const more = work.filter((w) => !w.flagship && !w.draft);
const essays = await getEssays();
---
<Base title="Work" description="Strategy, building, and enablement, usually all three at once.">
  <section class="section">
    <div class="wrap">
      <h1 class="display-xl">Work</h1>
      <p class="lede measure" style="margin-top: var(--space-2)">Strategy, building, and enablement, usually all three at once.</p>

      <div class="filters" role="group" aria-label="Filter by pillar" hidden>
        {["All", ...pillars].map((p, i) => (
          <button type="button" class="filter" data-filter={p} aria-pressed={i === 0 ? "true" : "false"}>{p}</button>
        ))}
      </div>

      <h2 class="ms-tag ms-tag--eyebrow eyebrow group-label">Flagships</h2>
      <div class="grid grid--3 filterable">
        {flagships.map((w) => (
          <Card pillar={w.pillar} title={w.title} summary={w.summary} stat={w.stat} status={w.status} href={`/work/${w.slug}`} />
        ))}
      </div>

      <h2 class="ms-tag ms-tag--eyebrow eyebrow group-label">More work</h2>
      <div class="grid grid--3 filterable more">
        {more.map((w) => (
          <Card pillar={w.pillar} title={w.title} summary={w.summary} stat={w.stat} status={w.status} href={`/work/${w.slug}`} />
        ))}
      </div>
      <h2 class="ms-tag ms-tag--eyebrow eyebrow group-label">Writing</h2>
      <div class="grid grid--3 filterable essays">
        {essays.map((e) => (
          <a class="ms-card essay" href={`/writing/${e.id}`} data-pillar={e.data.pillar}>
            <div class="ms-card__top">
              <span class="ms-tag ms-tag--pillar" data-pillar={e.data.pillar}>{e.data.pillar}</span>
              <span class="essay__kind"><span class="ms-tag ms-tag--eyebrow">Essay</span> · {readTime(e.body)}</span>
            </div>
            <h3 class="essay__title">{e.data.title}</h3>
            <p class="ms-card__body">{e.data.teaser}</p>
            <span class="ms-card__cta">Read essay <span aria-hidden="true">&rarr;</span></span>
          </a>
        ))}
      </div>
      <p class="empty body-s muted" hidden>Nothing here for this pillar yet.</p>
    </div>
  </section>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-3); }
  .filter { font: inherit; font-size: var(--type-body-s-size); line-height: 20px; font-weight: 600; padding: 6px 14px; border-radius: var(--radius-pill); border: 1px solid var(--line); background: var(--paper-raised); color: var(--ink); cursor: pointer; }
  .filter { -webkit-tap-highlight-color: transparent; }
  .filter:hover { border-color: var(--ink); }
  /* Active chip uses the pillar's tag colors. "All" is a neutral tone that no pillar uses. */
  .filter[aria-pressed="true"] { background: var(--line); border-color: var(--ink); color: var(--ink); }
  .filter[aria-pressed="true"][data-filter="Strategy"] { background: var(--brass-tint); border-color: var(--brass-ink); color: var(--brass-ink); }
  .filter[aria-pressed="true"][data-filter="Building"] { background: var(--turquoise-tint); border-color: var(--turquoise-ink); color: var(--turquoise-ink); }
  .filter[aria-pressed="true"][data-filter="Enablement"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .group-label { margin-top: var(--space-4); }
  /* Essays: no fill, smaller type, and an "Essay" label, so they don't read as projects. */
  .essay { background: transparent; border-style: dashed; padding: var(--space-2) var(--space-3); gap: var(--space-1); }
  .essay:hover { background: var(--paper-raised); }
  .essay__kind { display: inline-flex; gap: 6px; align-items: center; font-size: var(--type-body-s-size); line-height: 20px; color: var(--ink-muted); }
  .essay__title { font-family: var(--font-serif); font-weight: 500; font-size: var(--type-body-size); line-height: var(--type-body-line); margin: 0; }
  .essay :global(.ms-card__body) { font-size: var(--type-body-s-size); line-height: var(--type-body-s-line); }
  .more :global(.ms-card__title) { font-size: var(--type-body-size); line-height: var(--type-body-line); }
</style>

<script>
  const bar = document.querySelector<HTMLElement>(".filters");
  if (bar) {
    bar.hidden = false; // chips only appear when JavaScript can run them
    const buttons = bar.querySelectorAll<HTMLButtonElement>(".filter");
    buttons.forEach((b) => b.addEventListener("click", () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      document.querySelectorAll<HTMLElement>(".filterable").forEach((grid) => {
        let shown = 0;
        grid.querySelectorAll<HTMLElement>(".ms-card").forEach((c) => {
          const on = f === "All" || c.dataset.pillar === f;
          c.hidden = !on; if (on) shown++;
        });
        const label = grid.previousElementSibling as HTMLElement | null;
        grid.hidden = shown === 0; if (label) label.hidden = shown === 0;
      });
    }));
  }
</script>
