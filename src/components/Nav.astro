---
// Design system Nav: name on the left (links home), five links, Menu button under 640px.
import { nav, site } from "../data/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(href + "/");
---
<header class="site-header">
  <nav class="ms-nav wrap-nav" aria-label="Main">
    <a class="ms-nav__name" href="/">{site.name}</a>
    <ul class="ms-nav__links" id="nav-links">
      {nav.map((i) => (
        <li><a class="ms-nav__link" href={i.href} aria-current={isCurrent(i.href) ? "page" : undefined}>{i.label}</a></li>
      ))}
    </ul>
    <button class="ms-nav__menu" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
  </nav>
</header>

<style>
  .wrap-nav { max-width: 1120px; margin: 0 auto; padding-left: var(--space-2); padding-right: var(--space-2); flex-wrap: wrap; border-bottom: 0; }
  .site-header { border-bottom: 1px solid var(--line); background: var(--paper); }
  @media (min-width: 720px) { .wrap-nav { padding-left: var(--space-3); padding-right: var(--space-3); } }
  @media (max-width: 640px) {
    .ms-nav__links.is-open { display: flex; flex-direction: column; gap: 0; width: 100%; padding-top: var(--space-1); }
    .ms-nav__links.is-open .ms-nav__link { display: block; padding: 12px 0; border-bottom: 1px solid var(--line); }
    .ms-nav__links.is-open .ms-nav__link[aria-current="page"] { border-bottom: 2px solid var(--brass); }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".ms-nav__menu");
  const links = document.getElementById("nav-links");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    btn.textContent = open ? "Menu" : "Close";
    links?.classList.toggle("is-open", !open);
  });
</script>
