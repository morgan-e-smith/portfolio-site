---
// Numbered decision cards. Two columns on desktop.
interface Item { title: string; body: string; label?: string }
interface Props { items: Item[]; prefix?: string; cols?: 2 | 3 }
const { items, prefix = "", cols = 2 } = Astro.props;
---
<ol class={`grid grid--${cols} decisions`} role="list">
  {items.map((d, i) => (
    <li class="decision">
      <span class="ms-tag ms-tag--eyebrow">{d.label ?? `${prefix}${String(i + 1).padStart(2, "0")}`}</span>
      <h3 class="card-title">{d.title}</h3>
      <p class="body-s muted" set:html={d.body} />
    </li>
  ))}
</ol>

<style>
  .decisions { list-style: none; padding: 0; margin: 0; }
  .decision { background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius-md); padding: var(--space-3); display: flex; flex-direction: column; gap: var(--space-1); }
</style>
