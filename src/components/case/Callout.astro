---
// Highlighted passage: raised paper, brass hairline on top. No colored side borders.
interface Props { label?: string }
const { label } = Astro.props;
---
<aside class="callout">
  {label && <span class="ms-tag ms-tag--eyebrow">{label}</span>}
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout { background: var(--paper-raised); border: 1px solid var(--line); border-top: 2px solid var(--brass); border-radius: var(--radius-md); padding: var(--space-3); max-width: 760px; }
  .callout__body { font-family: var(--font-serif); font-size: var(--type-card-title-size); line-height: var(--type-card-title-line); }
  .callout .ms-tag + .callout__body { margin-top: var(--space-1); }
  .callout__body :global(p + p) { margin-top: var(--space-2); }
</style>
