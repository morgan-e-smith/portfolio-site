---
// Table that stacks into labelled rows on phones. Cell strings may hold inline HTML (code, strong).
interface Props { headers: string[]; rows: string[][]; caption?: string }
const { headers, rows, caption } = Astro.props;
---
<div class="dt">
  <table>
    {caption && <caption class="ms-tag ms-tag--eyebrow">{caption}</caption>}
    <thead><tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>{r.map((c, i) => <td data-label={headers[i]} set:html={c} />)}</tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .dt table { width: 100%; border-collapse: collapse; font-size: var(--type-body-s-size); line-height: var(--type-body-s-line); background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius-md); }
  caption { text-align: left; padding-bottom: var(--space-1); }
  th { text-align: left; font-size: 12px; line-height: 16px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--brass-ink); padding: 12px 16px; border-bottom: 1px solid var(--brass); }
  td { padding: 12px 16px; border-top: 1px solid var(--line); vertical-align: top; color: var(--ink-muted); }
  td:first-child { color: var(--ink); font-weight: 600; }
  tr:first-child td { border-top: 0; }
  @media (max-width: 720px) {
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    table, tbody, tr, td { display: block; }
    tr { padding: var(--space-2); border-top: 1px solid var(--line); }
    tr:first-child { border-top: 0; }
    td { border: 0; padding: 4px 0; }
    td::before { content: attr(data-label); display: block; font-size: 11px; line-height: 16px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--brass-ink); }
  }
</style>
