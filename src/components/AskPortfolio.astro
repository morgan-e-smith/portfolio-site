---
// "Ask my portfolio" (brief section 13). The UI is here; the serverless
// function and test set come in build step 5. Hidden unless site.assistantEnabled.
---
<section class="section" id="ask" aria-labelledby="ask-heading">
  <div class="wrap">
    <div class="measure">
      <h2 class="display-l" id="ask-heading">Ask anything about my work</h2>
      <p class="lede" style="margin-top: var(--space-2)">Built with the Claude API and grounded in this site's case studies and my resume.</p>
    </div>
    <form class="ask" id="ask-form">
      <label class="visually-hidden" for="ask-input">Your question</label>
      <div class="ask__row">
        <input id="ask-input" name="q" type="text" maxlength="300" autocomplete="off" placeholder="Has she led change without direct authority?" required />
        <button class="ms-btn ms-btn--primary" type="submit" id="ask-submit">Ask</button>
      </div>
      <p class="body-s muted ask__notice">Questions and answers are saved without any personal data, so Morgan can improve this assistant.</p>
      <div class="ask__chips" role="list">
        {["What's the most complex thing she's built?", "How does she work with engineering teams?", "What results has she driven?"].map((q) => (
          <button type="button" class="chip" role="listitem" data-q={q}>{q}</button>
        ))}
      </div>
      <div class="ask__answer" id="ask-answer" aria-live="polite" hidden></div>
      <p class="body-s muted">AI answers can be wrong. The case studies are the source of truth.</p>
    </form>
    <p class="body-s built"><strong>Curious how this portfolio was built?</strong> <a href="/work/building-this-site">See how I designed, built, and tested it →</a></p>
  </div>
</section>

<style>
  .built { margin-top: var(--space-3); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ask { margin-top: var(--space-3); display: flex; flex-direction: column; gap: var(--space-2); max-width: 760px; }
  .ask__row { display: flex; gap: var(--space-1); flex-wrap: wrap; }
  .ask__row input { flex: 1 1 260px; font: inherit; font-size: var(--type-body-s-size); padding: 12px 16px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--paper-raised); color: var(--ink); }
  .ask__row input::placeholder { color: var(--ink-muted); }
  .ask__chips { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .chip { font: inherit; font-size: var(--type-body-s-size); line-height: 20px; background: var(--paper-raised); color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius-pill); padding: 6px 14px; cursor: pointer; text-align: left; }
  .chip:hover { border-color: var(--turquoise-ink); }
  .ask__notice { margin-top: calc(var(--space-1) * -1); }
  .ask__notice + .ask__chips { margin-top: 0; }
  .ask__answer { background: var(--paper-raised); border: 1px solid var(--line); border-top: 2px solid var(--brass); border-radius: var(--radius-md); padding: var(--space-3); }
  .ask__answer :global(.ask__text) { font-size: var(--type-body-size); line-height: var(--type-body-line); }
  .ask__answer :global(.ask__sources) { margin-top: var(--space-2); font-size: var(--type-body-s-size); color: var(--ink-muted); }
  .ask__answer :global(.ask__sources a), .ask__answer :global(.ask__sources span) { margin-right: var(--space-2); }
  .ask__answer.is-loading { color: var(--ink-muted); }
</style>

<script>
  const form = document.getElementById("ask-form") as HTMLFormElement;
  const input = document.getElementById("ask-input") as HTMLInputElement;
  const submit = document.getElementById("ask-submit") as HTMLButtonElement;
  const out = document.getElementById("ask-answer") as HTMLDivElement;

  async function send(question: string) {
    out.hidden = false;
    out.classList.add("is-loading");
    out.textContent = "Looking through the case studies…";
    submit.disabled = true;
    try {
      const res = await fetch("/api/ask", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ question }) });
      const data = await res.json().catch(() => ({}));
      out.classList.remove("is-loading");
      out.textContent = "";
      const p = document.createElement("p");
      p.className = "ask__text";
      p.textContent = data.answer || data.message || "I can't answer that one here. The case studies are the source of truth, and you can reach Morgan through the Contact section.";
      out.append(p);
      if (Array.isArray(data.sources) && data.sources.length) {
        const s = document.createElement("p");
        s.className = "ask__sources";
        s.append("Sources: ");
        for (const src of data.sources) {
          const a = document.createElement(src.url === "/faq" ? "span" : "a");
          if (a instanceof HTMLAnchorElement) a.href = src.url;
          a.textContent = src.url === "/faq" ? "Morgan's FAQ answers" : src.title;
          s.append(a);
        }
        out.append(s);
      }
    } catch {
      out.classList.remove("is-loading");
      out.textContent = "I can't answer that one here. The case studies are the source of truth, and you can reach Morgan through the Contact section.";
    } finally {
      submit.disabled = false;
    }
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (q) send(q);
  });
  document.querySelectorAll<HTMLButtonElement>(".ask .chip").forEach((chip) => {
    chip.addEventListener("click", () => { input.value = chip.dataset.q || ""; send(input.value); });
  });
</script>
